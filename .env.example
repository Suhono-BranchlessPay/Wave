# BranchlessPay
BP_LICENSE_KEY=bp_test_YOUR_TOKEN_HERE
BP_API_URL=https://branchlesspay.com/api/v1/anchor

# Wave OAuth (developer.waveapps.com)
WAVE_CLIENT_ID=
WAVE_CLIENT_SECRET=
WAVE_REDIRECT_URI=http://localhost:8765/oauth/callback
WAVE_ACCESS_TOKEN=
WAVE_REFRESH_TOKEN=
WAVE_BUSINESS_ID=

# Optional — verify page Business Information (M3)
WAVE_BUSINESS_NAME=
WAVE_BUSINESS_ADDRESS=

# Webhook secret (from Wave webhook registration)
WAVE_WEBHOOK_SECRET=

# Server
HOST=127.0.0.1
PORT=8080

# Local dev only — never enable in production
WAVE_SKIP_SIGNATURE_VERIFY=0
